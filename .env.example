# Semantic Drift Monitor environment template
#
# Copy this file to .env for local use. Do not commit .env.

# Optional official/approved data-source credentials.
# The baseline repository does not require these for the demo pipeline.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1

# Optional contact string for permitted web requests.
SEMANTIC_DRIFT_USER_AGENT=SemanticDriftMonitor/0.1 academic-research contact:your-email@example.com

